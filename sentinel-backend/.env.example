# CyberTech AI Backend Environment Configuration

# Database & Core
DATABASE_URL=sqlite+aiosqlite:///./sentinel.db
SECRET_KEY=cybertech-ai-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
MODEL_NAME=baseline
MODEL_VERSION=1.0.0
DEMO_MODE=true
LOG_LEVEL=INFO

# Centralized Server-Side Social Media API Credentials
# Configure these on your backend hosting provider (e.g. Render, Railway, AWS, or local .env)

# YouTube Data API v3 (Google Cloud Console)
# Obtain from: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# Instagram Graph API (Meta for Developers / Instagram Business)
# Obtain from: https://developers.facebook.com/apps/
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# Google Sign-In OAuth 2.0 Credentials (Google Cloud Console)
# Obtain from: https://console.cloud.google.com/apis/credentials
# Ensure Authorized JavaScript Origins include your frontend domain (e.g. http://localhost:5173)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
